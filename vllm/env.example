# Export these variables before platform.sh; this file is documentation, not automatically sourced.
VLLM_MODEL_DIR=/path/to/modelscope/models
VLLM_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# Optional path INSIDE the container; defaults to /models/$VLLM_MODEL_NAME.
VLLM_MODEL_PATH=
VLLM_GPU_DEVICE=0
VLLM_PORT=8000
VLLM_BIND_HOST=127.0.0.1
VLLM_GPU_MEMORY_UTILIZATION=0.2
VLLM_DTYPE=half
VLLM_MAX_MODEL_LEN=512
VLLM_MAX_NUM_SEQS=32
VLLM_EMBEDDING_DIMENSIONS=1024
VLLM_API_KEY=
