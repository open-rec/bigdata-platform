# ---------------------------------------------------------------------------
# open-rec bigdata-platform — single source of truth for versions, ports and
# sizing. Everything docker-compose.yml interpolates is defined here.
#
# Docker Compose reads this file automatically when you run compose from this
# directory (platform.sh always does).
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=openrec-bigdata

# --- image names -----------------------------------------------------------
# Every component is built from its own Dockerfile into openrec/<component>,
# so each one can be deployed on its own (docker run / k8s / another compose
# file) without this repo's orchestration. Postgres is the only exception: it
# is used as-is.
IMAGE_PREFIX=openrec

# --- component versions ----------------------------------------------------
# These pick both the image tag and, where the Dockerfile downloads a release
# tarball (zookeeper, kafka, hbase), the version fetched from the configured
# mainland mirror.
ZOOKEEPER_VERSION=3.9.2
KAFKA_VERSION=3.7.1
KAFKA_SCALA_VERSION=2.13
HADOOP_VERSION=3.3.6
HIVE_VERSION=4.0.1
HBASE_VERSION=2.5.10
SPARK_VERSION=3.5.3
FLINK_VERSION=1.14.6
REDIS_VERSION=7.2-alpine
# 8.5.0 is not arbitrary: it is what recall-engine/es/local/install.sh installs
# and what rec-server's elasticsearch-java client is pinned to
# (rec-server/pom.xml). Bumping this means checking that client version too.
ELASTIC_VERSION=8.5.0
POSTGRES_VERSION=15-alpine
PROMETHEUS_VERSION=v3.5.0
GRAFANA_VERSION=12.1.0

# --- base images -----------------------------------------------------------
# Keep these in step with the versions above; .env cannot interpolate itself.
# zookeeper, kafka and hbase are built on a bare JRE from the Apache tarball;
# the rest extend the upstream vendor image.
JRE_BASE_IMAGE=eclipse-temurin:11-jre-jammy
HADOOP_BASE_IMAGE=apache/hadoop:3.3.6
HIVE_BASE_IMAGE=apache/hive:4.0.1
SPARK_BASE_IMAGE=apache/spark:3.5.3-python3
FLINK_BASE_IMAGE=flink:1.14.6-scala_2.12-java8
# DaoCloud's mainland mirror proxies the official Docker Hub images.
AIRFLOW_IMAGE=m.daocloud.io/docker.io/apache/airflow:3.3.0-python3.12
PROMETHEUS_IMAGE=m.daocloud.io/docker.io/prom/prometheus:v3.5.0
GRAFANA_IMAGE=m.daocloud.io/docker.io/grafana/grafana:12.1.0
REDIS_BASE_IMAGE=redis:7.2-alpine
ELASTIC_BASE_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.5.0

# --- extra jars baked into the images --------------------------------------
PG_JDBC_VERSION=42.7.4
KAFKA_CLIENTS_VERSION=3.4.1
COMMONS_POOL2_VERSION=2.11.1
JUPYTERLAB_VERSION=4.2.5
HAPPYBASE_VERSION=1.2.0
FLINK_HADOOP_UBER_VERSION=2.8.3-10.0
FROCKSDBJNI_VERSION=6.20.3-ververica-1.0

# --- host ports ------------------------------------------------------------
# Nothing here collides with the open-rec services themselves: 13579
# (rec-server) and 8000 (rank-engine).
ZK1_CLIENT_PORT=22181
ZK2_CLIENT_PORT=32181
ZK3_CLIENT_PORT=42181

KAFKA1_EXTERNAL_PORT=19092
KAFKA2_EXTERNAL_PORT=29092
KAFKA3_EXTERNAL_PORT=39092

NAMENODE_RPC_PORT=8020
NAMENODE_UI_PORT=9870
DATANODE1_UI_PORT=9864
DATANODE2_UI_PORT=9865

RESOURCEMANAGER_UI_PORT=8088
NODEMANAGER1_UI_PORT=8042
NODEMANAGER2_UI_PORT=8043

HIVE_PG_PORT=15432
HIVE_METASTORE_PORT=9083
HIVESERVER2_PORT=10000
HIVESERVER2_UI_PORT=10002

HBASE_MASTER_PORT=16001
HBASE_MASTER_UI_PORT=16010
HBASE_RS1_PORT=16020
HBASE_RS1_UI_PORT=16030
HBASE_RS2_PORT=16021
HBASE_RS2_UI_PORT=16031
HBASE_THRIFT_PORT=9090
HBASE_THRIFT_UI_PORT=9095

# Elasticsearch keeps its default host port. Redis uses 6380 to avoid a local
# Redis collision; configure host-side clients accordingly.
REDIS_PORT=6380
ELASTIC_HTTP_PORT=9200

SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8083
SPARK_WORKER1_UI_PORT=8084
SPARK_WORKER2_UI_PORT=8086
SPARK_HISTORY_UI_PORT=18080
JUPYTERLAB_PORT=8889
SPARK_DRIVER_UI_PORT=4040

AIRFLOW_API_PORT=8091
AIRFLOW_UID=50000
# Shared by the scheduler and API server to sign Airflow 3 task-execution JWTs.
AIRFLOW_JWT_SECRET=openrec-local-airflow-jwt-secret-change-me
# Override with an absolute path when another project owns the business DAGs.
AIRFLOW_DAGS_PATH=./airflow/dags

FLINK_JOBMANAGER_UI_PORT=8087

PROMETHEUS_PORT=9091
GRAFANA_PORT=3000

# --- sizing ----------------------------------------------------------------
# The defaults are laptop-friendly. On a real box raise SPARK_WORKER_* and the
# heaps first — those bound how much data you can actually process.
#
# Cluster *shape* now lives in the images' config files rather than here,
# because it has to agree with the number of containers compose starts:
#   dfs.replication                  -> hadoop/conf/hdfs-site.xml
#   yarn.nodemanager.resource.*      -> hadoop/conf/yarn-site.xml
ZOOKEEPER_HEAP=1024
KAFKA_HEAP_OPTS=-Xmx1g -Xms1g

SPARK_WORKER_MEMORY=4g
SPARK_DAEMON_MEMORY=1g

FLINK_JOBMANAGER_MEMORY=1024m
FLINK_TASKMANAGER_MEMORY=2048m
FLINK_TASK_SLOTS=2

HBASE_MASTER_HEAPSIZE=1g
HBASE_REGIONSERVER_HEAPSIZE=2g

HIVE_METASTORE_HEAP=-Xmx1g
HIVESERVER2_HEAP=-Xmx2g

# --- kafka topics created by the kafka-init one-shot -----------------------
# These are the three topics rec-server publishes to (spring.kafka.topic.*).
KAFKA_TOPICS=item,user,event
KAFKA_TOPIC_PARTITIONS=12
KAFKA_TOPIC_REPLICATION=3

# --- redis -----------------------------------------------------------------
# No password: rec-server's RedisConfig, example/init's RedisUtil and
# rank-engine's redis client all connect without one, so setting requirepass
# here would break every one of them.
# maxmemory 0 means unlimited; set a real cap before loading a large dataset.
REDIS_MAXMEMORY=0
REDIS_MAXMEMORY_POLICY=noeviction

# --- elasticsearch ---------------------------------------------------------
# rec-server's EsConfig hardcodes the https scheme and always sends basic auth,
# so this node runs with TLS and security on. Both clients trust self-signed
# certs deliberately (withUnsafeTrustMaterial), so the CA generated by the
# image's entrypoint never has to leave the container.
#
# Set es.password in rec-server/server/src/main/resources/application-*.properties
# to this value, or change this to match what is already there.
ELASTIC_PASSWORD=openrec-es-password
ELASTIC_HEAP=-Xms2g -Xmx2g

# --- hive metastore database ----------------------------------------------
# Must match the connection settings in hive/conf/hive-site.xml.
HIVE_DB_NAME=metastore
HIVE_DB_USER=hive
HIVE_DB_PASSWORD=hive

# --- airflow ---------------------------------------------------------------
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_ADMIN_USERS=admin:admin

# --- monitoring ------------------------------------------------------------
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=openrec-grafana-password
