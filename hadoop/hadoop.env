# ---------------------------------------------------------------------------
# Shared Hadoop configuration for every namenode / datanode / resourcemanager
# / nodemanager container.
#
# The apache/hadoop image translates env vars named <FILE>_<property> into the
# matching XML config file at startup, so `CORE-SITE.XML_fs.defaultFS=x` ends
# up as the fs.defaultFS property in core-site.xml.
#
# NOTE: env_file values are literal — docker compose does not interpolate .env
# into this file. Anything that must be tunable from .env is overridden in the
# `environment:` block of the service instead (dfs.replication, the nodemanager
# resource limits), which takes precedence over what is set here.
# ---------------------------------------------------------------------------

# --- core-site.xml ---------------------------------------------------------
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.tmp.dir=/opt/hadoop/tmp
CORE-SITE.XML_hadoop.http.staticuser.user=root
# Hive and Spark impersonate end users when they talk to HDFS.
CORE-SITE.XML_hadoop.proxyuser.root.hosts=*
CORE-SITE.XML_hadoop.proxyuser.root.groups=*
CORE-SITE.XML_hadoop.proxyuser.hive.hosts=*
CORE-SITE.XML_hadoop.proxyuser.hive.groups=*
CORE-SITE.XML_hadoop.proxyuser.spark.hosts=*
CORE-SITE.XML_hadoop.proxyuser.spark.groups=*

# --- hdfs-site.xml ---------------------------------------------------------
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.http-address=0.0.0.0:9870
# The volumes are mounted on /opt/hadoop/dfs, one level above these dirs — see
# the comment on the namenode service in docker-compose.yml.
HDFS-SITE.XML_dfs.namenode.name.dir=/opt/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/opt/hadoop/dfs/data
HDFS-SITE.XML_dfs.replication=2
HDFS-SITE.XML_dfs.webhdfs.enabled=true
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
# This is a lab platform: file ownership across Hive / HBase / Spark containers
# is more trouble than it is worth. Turn permission checks back on if you point
# real users at it.
HDFS-SITE.XML_dfs.permissions.enabled=false

# --- yarn-site.xml ---------------------------------------------------------
YARN-SITE.XML_yarn.resourcemanager.hostname=resourcemanager
YARN-SITE.XML_yarn.resourcemanager.address=resourcemanager:8032
YARN-SITE.XML_yarn.resourcemanager.scheduler.address=resourcemanager:8030
YARN-SITE.XML_yarn.resourcemanager.resource-tracker.address=resourcemanager:8031
YARN-SITE.XML_yarn.resourcemanager.webapp.address=0.0.0.0:8088
YARN-SITE.XML_yarn.nodemanager.aux-services=mapreduce_shuffle
YARN-SITE.XML_yarn.nodemanager.webapp.address=0.0.0.0:8042
# Containers get killed on virtual-memory overshoot otherwise; the JVM's
# reserved virtual address space regularly trips the default 2.1 ratio.
YARN-SITE.XML_yarn.nodemanager.vmem-check-enabled=false
YARN-SITE.XML_yarn.nodemanager.resource.memory-mb=8192
YARN-SITE.XML_yarn.nodemanager.resource.cpu-vcores=4
YARN-SITE.XML_yarn.scheduler.minimum-allocation-mb=512
YARN-SITE.XML_yarn.scheduler.maximum-allocation-mb=8192
YARN-SITE.XML_yarn.log-aggregation-enable=true
YARN-SITE.XML_yarn.application.classpath=/opt/hadoop/etc/hadoop,/opt/hadoop/share/hadoop/common/*,/opt/hadoop/share/hadoop/common/lib/*,/opt/hadoop/share/hadoop/hdfs/*,/opt/hadoop/share/hadoop/hdfs/lib/*,/opt/hadoop/share/hadoop/mapreduce/*,/opt/hadoop/share/hadoop/mapreduce/lib/*,/opt/hadoop/share/hadoop/yarn/*,/opt/hadoop/share/hadoop/yarn/lib/*

# --- mapred-site.xml -------------------------------------------------------
MAPRED-SITE.XML_mapreduce.framework.name=yarn
MAPRED-SITE.XML_mapreduce.jobhistory.address=resourcemanager:10020
MAPRED-SITE.XML_yarn.app.mapreduce.am.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.map.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.reduce.env=HADOOP_MAPRED_HOME=/opt/hadoop
